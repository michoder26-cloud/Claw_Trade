# AI Provider
OPENROUTER_API_KEY=placeh...

# === Mock AI Mode (for testing without AI costs) ===
USE_MOCK_AI=true

# === MT5 Connection ===
# Linux (Docker + mt5linux): Install `pip install mt5linux rpyc`
# Windows (native): Install `pip install MetaTrader5`
MT5_HOST=127.0.0.1
MT5_PORT=8001

# === Broker Settings ===
# FBS MT5 Account
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=FBS
# Check your broker's Market Watch for exact symbol (e.g., XAUUSD, XAUUSDc, GOLD)
MT5_SYMBOL=XAUUSDc

# === Trading Settings ===
XAU_USD_SYMBOL=XAUUSD
BACKTESTING_START_DATE=2023-01-01
BACKTESTING_END_DATE=2024-12-31
INITIAL_BALANCE=10000
POSITION_SIZE_PERCENT=6.0
FIXED_LOT_SIZE=0.0
MAX_DAILY_TRADES=5

# === Data Source ===
DATA_SOURCE=mt5
YFINANCE_INTERVAL=1h

# === Risk Management ===
MAX_DRAWDOWN_PERCENT=10
RISK_REWARD_RATIO=3.0
MAX_OPEN_POSITIONS=2
USE_DCA=False
USE_FIXED_SL_TP=False
FIXED_SL_USD=15.0
FIXED_TP_USD=30.0

# === Trailing Stop ===
USE_TRAILING_STOP=True
TRAIL_BREAKEVEN_TRIGGER=1.0
TRAIL_LOCK_TRIGGER=2.0

# === Notifications ===
DISCORD_TRADE_WEBHOOK_URL=
DISCORD_NEWS_WEBHOOK_URL=
DISCORD_GOLD_REFLECTION_WEBHOOK=
DISCORD_DAILY_STOCK_WEBHOOK=
DISCORD_WEEKLY_REFLECTION_WEBHOOK=